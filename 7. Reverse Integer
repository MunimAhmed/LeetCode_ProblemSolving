class Solution:
    def reverse(self, x: int) -> int:
        y = 0

        while x != 0:
            digit = x % 10

            # Python's -123 % 10 is 7; we need -3.
            if x < 0 and digit != 0:
                digit -= 10

            # Remove the last digit; works for either sign.
            x = (x - digit) // 10
            
             # Prevent exceeding 2147483647.
            if y > 214748364 or (y == 214748364 and digit > 7):
                return 0

            # Prevent going below -2147483648.
            if y < -214748364 or (y == -214748364 and digit < -8):
                return 0

            y = y * 10 + digit

        return y
